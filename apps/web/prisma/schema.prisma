// =============================================================================
// Nexurops Agency Platform - MongoDB Schema (Prisma)
// =============================================================================
// Target: MongoDB Atlas (replica set required for Prisma transactions)
// Auth:   NextAuth.js v4 with @next-auth/prisma-adapter
// IDs:    cuid strings stored as `_id` (keeps ids opaque and FK types simple)
// Money:  Float (MongoDB connector has no Decimal); amounts are USD with 2dp
// Note:   no @unique on optional fields: MongoDB unique indexes treat every
//         null as the same value, so a second null would be rejected.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  CHURNED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ProjectStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  LOST
}

enum LeadSource {
  WEBSITE
  LINKEDIN
  OUTREACH
  REFERRAL
}

enum ServiceCategory {
  AI
  CYBERSECURITY
  WEB_DEV
  MARKETING
  SEO
}

enum TeamRole {
  SUPER_ADMIN
  ADMIN
  TEAM_LEAD
}

// =============================================================================
// AUTHENTICATION (NextAuth.js v4 compatible)
// =============================================================================
// These four models MUST match @auth/prisma-adapter expectations exactly.
// Additional fields (role, password) are safe extensions.
// =============================================================================

model User {
  id            String    @id @default(cuid()) @map("_id")
  email         String    @unique // unique constraint = implicit unique index
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?   // bcrypt hash; null for OAuth-only users
  role          Role      @default(CLIENT)

  // --- NextAuth relations ---
  accounts Account[]
  sessions Session[]

  // --- Business relations ---
  clients     Client[]
  teamMember  TeamMember?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String  // "oauth" | "oidc" | "email" | "credentials"
  provider          String  // "google" | "github" etc.
  providerAccountId String
  refresh_token     String? // OAuth tokens can exceed 191 chars
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// BUSINESS ENTITIES
// =============================================================================

model Client {
  id      String       @id @default(cuid()) @map("_id")
  userId  String
  name    String
  company String?
  email   String       @unique // client contact email (may differ from User.email)
  phone   String?
  status  ClientStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // --- Downstream relations ---
  projects        Project[]
  orders          Order[]
  invoices        Invoice[]
  linkedInPosts   LinkedInPost[]
  linkedInMetrics LinkedInMetrics[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete: filter with WHERE deletedAt IS NULL

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("clients")
}

model Service {
  id          String          @id @default(cuid()) @map("_id")
  name        String
  description String
  slug        String          @unique // URL-safe identifier, e.g. "ai-consulting"
  basePrice   Float          // max 99,999,999.99
  features    Json            @default("[]") // string[] of feature names
  category    ServiceCategory
  isActive    Boolean         @default(true)

  orders Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([isActive, category])
  @@map("services")
}

model Order {
  id              String      @id @default(cuid()) @map("_id")
  clientId        String
  serviceId       String
  totalAmount     Float     
  status          OrderStatus @default(PENDING)
  stripeInvoiceId String? // Stripe payment reference (indexed, not unique: see header note)
  notes           String?

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // --- downstream (one per order in practice; 1:n because a 1:1 needs @unique on an optional FK) ---
  projects Project[]
  invoices Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([serviceId])
  @@index([status])
  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([stripeInvoiceId])
  @@map("orders")
}

model Project {
  id          String        @id @default(cuid()) @map("_id")
  clientId    String
  orderId     String? // optional: projects can exist without orders
  title       String
  description String?
  status      ProjectStatus @default(BACKLOG)
  budget      Float?      
  startDate   DateTime?
  deadline    DateTime?
  metadata    Json          @default("{}") // { accountManager, tags[], customFields }

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  invoices Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([orderId])
  @@map("projects")
}

model Invoice {
  id              String        @id @default(cuid()) @map("_id")
  clientId        String
  projectId       String?
  orderId         String?
  invoiceNumber   String        @unique // human-readable: INV-2024-0001
  amount          Float        // subtotal before tax
  tax             Float       @default(0) 
  totalAmount     Float        // amount + tax
  currency        String        @default("USD")
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime
  paidAt          DateTime?
  stripeInvoiceId String?
  notes           String?

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([orderId])
  @@index([stripeInvoiceId])
  @@map("invoices")
}

// =============================================================================
// LINKEDIN INTEGRATION
// =============================================================================

model LinkedInPost {
  id                String     @id @default(cuid()) @map("_id")
  clientId          String
  url               String? // LinkedIn post URL (set after publish)
  text              String
  status            PostStatus @default(DRAFT)
  humanizationScore Float?     // 0.0 - 1.0 AI detection avoidance score
  impressions       Int        @default(0)
  likes             Int        @default(0)
  comments          Int        @default(0)
  shares            Int        @default(0)
  engagementRate    Float      @default(0) // (likes+comments+shares) / impressions

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  scheduledAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([clientId, status])
  @@index([clientId, createdAt])
  @@index([publishedAt])
  @@map("linkedin_posts")
}

model LinkedInMetrics {
  id                String   @id @default(cuid()) @map("_id")
  clientId          String
  date              DateTime // one row per client per day
  totalImpressions  Int      @default(0)
  totalEngagement   Int      @default(0)
  postsPublished    Int      @default(0)
  avgEngagementRate Float    @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date]) // enforce one metrics row per client per day
  @@index([date])
  @@map("linkedin_metrics")
}

// =============================================================================
// LEAD MANAGEMENT
// =============================================================================

model Lead {
  id          String     @id @default(cuid()) @map("_id")
  name        String
  email       String     // not unique: same person can submit multiple leads
  phone       String?
  service     String?    // free-text or ServiceCategory string
  message     String?
  source      LeadSource @default(WEBSITE)
  utmCampaign String?
  utmSource   String?
  utmMedium   String?
  status      LeadStatus @default(NEW)
  metadata    Json       @default("{}") // { referer, landingPage, userAgent, ip }
  assignedTo  String?    // userId of team member handling this lead

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([status])
  @@index([source])
  @@index([source, status])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("leads")
}

// =============================================================================
// TEAM MANAGEMENT
// =============================================================================

model TeamMember {
  id          String   @id @default(cuid()) @map("_id")
  userId      String   @unique // 1:1 with User -- a user is on the team or not
  role        TeamRole @default(ADMIN)
  department  String?
  permissions Json     @default("[]") // string[] of permission slugs

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@map("team_members")
}
