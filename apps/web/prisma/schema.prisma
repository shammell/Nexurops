// =============================================================================
// Nexurops Agency Platform - PostgreSQL Schema (Prisma)
// =============================================================================
// Target: PostgreSQL 15+ (Supabase production, Docker local dev)
// Auth:   NextAuth.js v4 with @auth/prisma-adapter
// Scale:  Designed for 100k+ users, composite indexes on hot query paths
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Supabase connection pooling bypass for migrations
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  CHURNED
}

enum OrderStatus {
  PENDING
  PAID
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ProjectStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  VOID
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  LOST
}

enum LeadSource {
  WEBSITE
  LINKEDIN
  OUTREACH
  REFERRAL
}

enum ServiceCategory {
  AI
  CYBERSECURITY
  WEB_DEV
  MARKETING
  SEO
}

enum TeamRole {
  SUPER_ADMIN
  ADMIN
  TEAM_LEAD
}

// =============================================================================
// AUTHENTICATION (NextAuth.js v4 compatible)
// =============================================================================
// These four models MUST match @auth/prisma-adapter expectations exactly.
// Additional fields (role, password) are safe extensions.
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique // unique constraint = implicit unique index
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?   // bcrypt hash; null for OAuth-only users
  role          Role      @default(CLIENT)

  // --- NextAuth relations ---
  accounts Account[]
  sessions Session[]

  // --- Business relations ---
  clients     Client[]
  teamMember  TeamMember?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // "oauth" | "oidc" | "email" | "credentials"
  provider          String  // "google" | "github" etc.
  providerAccountId String
  refresh_token     String? @db.Text // OAuth tokens can exceed 191 chars
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// BUSINESS ENTITIES
// =============================================================================

model Client {
  id      String       @id @default(cuid())
  userId  String
  name    String
  company String?
  email   String       @unique // client contact email (may differ from User.email)
  phone   String?
  status  ClientStatus @default(ACTIVE)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  // --- Downstream relations ---
  projects        Project[]
  orders          Order[]
  invoices        Invoice[]
  linkedInPosts   LinkedInPost[]
  linkedInMetrics LinkedInMetrics[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete: filter with WHERE deletedAt IS NULL

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@map("clients")
}

model Service {
  id          String          @id @default(cuid())
  name        String
  description String          @db.Text
  slug        String          @unique // URL-safe identifier, e.g. "ai-consulting"
  basePrice   Decimal         @db.Decimal(10, 2) // max 99,999,999.99
  features    Json            @default("[]") // string[] of feature names
  category    ServiceCategory
  isActive    Boolean         @default(true)

  orders Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([category])
  @@index([isActive, category])
  @@map("services")
}

model Order {
  id              String      @id @default(cuid())
  clientId        String
  serviceId       String
  totalAmount     Decimal     @db.Decimal(10, 2)
  status          OrderStatus @default(PENDING)
  stripeInvoiceId String?     @unique // Stripe idempotency key
  notes           String?     @db.Text

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  // --- 1:1 optional downstream ---
  project Project?
  invoice Invoice?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([serviceId])
  @@index([status])
  @@index([clientId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("orders")
}

model Project {
  id          String        @id @default(cuid())
  clientId    String
  orderId     String?       @unique // 1:1 with Order (optional -- projects can exist without orders)
  title       String
  description String?       @db.Text
  status      ProjectStatus @default(BACKLOG)
  budget      Decimal?      @db.Decimal(10, 2)
  startDate   DateTime?
  deadline    DateTime?
  metadata    Json          @default("{}") // { accountManager, tags[], customFields }

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  invoices Invoice[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([clientId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("projects")
}

model Invoice {
  id              String        @id @default(cuid())
  clientId        String
  projectId       String?
  orderId         String?       @unique // 1:1 with Order
  invoiceNumber   String        @unique // human-readable: INV-2024-0001
  amount          Decimal       @db.Decimal(10, 2) // subtotal before tax
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2) // amount + tax
  currency        String        @default("USD") @db.VarChar(3)
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime
  paidAt          DateTime?
  stripeInvoiceId String?       @unique
  notes           String?       @db.Text

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([clientId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@map("invoices")
}

// =============================================================================
// LINKEDIN INTEGRATION
// =============================================================================

model LinkedInPost {
  id                String     @id @default(cuid())
  clientId          String
  url               String?    // LinkedIn post URL (set after publish)
  text              String     @db.Text
  status            PostStatus @default(DRAFT)
  humanizationScore Float?     // 0.0 - 1.0 AI detection avoidance score
  impressions       Int        @default(0)
  likes             Int        @default(0)
  comments          Int        @default(0)
  shares            Int        @default(0)
  engagementRate    Float      @default(0) // (likes+comments+shares) / impressions

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  scheduledAt DateTime?

  @@index([clientId])
  @@index([status])
  @@index([clientId, status])
  @@index([clientId, createdAt(sort: Desc)])
  @@index([publishedAt])
  @@map("linkedin_posts")
}

model LinkedInMetrics {
  id                String   @id @default(cuid())
  clientId          String
  date              DateTime @db.Date // one row per client per day
  totalImpressions  Int      @default(0)
  totalEngagement   Int      @default(0)
  postsPublished    Int      @default(0)
  avgEngagementRate Float    @default(0)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date]) // enforce one metrics row per client per day
  @@index([date])
  @@map("linkedin_metrics")
}

// =============================================================================
// LEAD MANAGEMENT
// =============================================================================

model Lead {
  id          String     @id @default(cuid())
  name        String
  email       String     // not unique: same person can submit multiple leads
  phone       String?
  service     String?    // free-text or ServiceCategory string
  message     String?    @db.Text
  source      LeadSource @default(WEBSITE)
  utmCampaign String?
  utmSource   String?
  utmMedium   String?
  status      LeadStatus @default(NEW)
  metadata    Json       @default("{}") // { referer, landingPage, userAgent, ip }
  assignedTo  String?    // userId of team member handling this lead

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([status])
  @@index([source])
  @@index([source, status])
  @@index([assignedTo])
  @@index([createdAt(sort: Desc)])
  @@map("leads")
}

// =============================================================================
// TEAM MANAGEMENT
// =============================================================================

model TeamMember {
  id          String   @id @default(cuid())
  userId      String   @unique // 1:1 with User -- a user is on the team or not
  role        TeamRole @default(ADMIN)
  department  String?
  permissions Json     @default("[]") // string[] of permission slugs

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@map("team_members")
}

