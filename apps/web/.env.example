# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nexurops"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Admin Credentials (for CredentialsProvider)
ADMIN_EMAIL="admin@nexurops.com"
ADMIN_PASSWORD="change-this-password"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# LinkedIn Bot
LINKEDIN_BOT_URL="http://localhost:8000"
LINKEDIN_BOT_TOKEN="your-bot-token"
LINKEDIN_WEBHOOK_SECRET="your-webhook-secret"

# App
APP_VERSION="1.0.0"
NODE_ENV="development"
